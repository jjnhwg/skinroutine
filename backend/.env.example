# Copy to .env. Every value here is optional; these are the defaults.
DATABASE_URL=sqlite:///./skinlog.db
PHOTO_DIR=./data/photos

# Required: the Supabase project users sign in with (the same URL as the
# frontend's VITE_SUPABASE_URL). The backend only reads its public keys.
SUPABASE_URL=https://your-project.supabase.co

# Required: signs photo links so <img> tags can load private photos without a
# sign-in token. Make one with:  python -c "import secrets; print(secrets.token_hex(32))"
PHOTO_LINK_SECRET=
