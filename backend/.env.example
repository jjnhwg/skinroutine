# Copy to .env. Every value here is optional; these are the defaults.
DATABASE_URL=sqlite:///./skinlog.db
PHOTO_DIR=./data/photos

# Reminder emails. "console" prints them; "smtp" sends them through any SMTP
# provider (Resend, Postmark, a Gmail app password…) using STARTTLS.
EMAIL_BACKEND=console
EMAIL_FROM=Skin Test Log <reminders@localhost>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Where the app is served; reminder emails link to <APP_URL>/#/log.
APP_URL=http://localhost:5173

# Push reminders. Make a key pair with `python -m skinlog.push --generate-keys`.
# Without keys, pushes are printed instead of sent. The subject is a contact
# address push services can use to reach you.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
